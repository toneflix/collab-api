APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=https://collab.toneflix.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the preferred database. MySQL/MariaDB and SQLite also work.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=toneflix_collab
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Realtime: none, reverb, pusher, ably or firebase. Admins can switch the
# driver on the admin Realtime page; its keys always come from here.
REALTIME_DRIVER=none

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

ABLY_KEY=

FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# local, or s3 for Amazon S3 and S3-compatible storage (MinIO, R2, Spaces, ...)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# For S3-compatible services, e.g. https://<account>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# Public address of the bucket, if it differs from the default S3 URL
AWS_URL=
# true signs file links (for private buckets); false gives plain bucket URLs
FILEABLE_TEMPORARY_URLS=true
# How long signed links last, in minutes
FILEABLE_TEMPORARY_URL_TTL=60

VITE_APP_NAME="${APP_NAME}"

PAYSTACK_PUBLIC_KEY=pk_test_****************************************
PAYSTACK_SECRET_KEY=sk_test_****************************************

STRIPE_SECRET_KEY=
# Optional: a separate key for Connect payouts. STRIPE_SECRET_KEY is used when empty.
STRIPE_CONNECT_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# From your API app at freesound.org/apiv2/apply
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=

# Browser push. Create the keys with `php artisan webpush:vapid`.
VAPID_SUBJECT=mailto:hello@toneflix.ng
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Minutes to wait before emailing or pushing unread messages
NOTIFY_MESSAGE_DELAY=5
