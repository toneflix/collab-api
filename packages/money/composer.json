{
    "name": "toneflix/money",
    "description": "Money formatting, arithmetic and currency conversion with live exchange rates. A PHP port of @toneflix/money.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "money",
        "currency",
        "conversion",
        "forex",
        "formatting",
        "toneflix"
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Toneflix\\Money\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toneflix\\Money\\Tests\\": "tests/"
        }
    }
}
