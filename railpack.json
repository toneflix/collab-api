{
  "$schema": "https://schema.railpack.com",
  "provider": "php",
  "steps": {
    "extensions": {
      "commands": [
        "...",
        "install-php-extensions bcmath exif gd gmp intl pcntl pdo_pgsql pgsql zip"
      ],
      "deployOutputs": []
    }
  },
  "deploy": {
    "aptPackages": [
      "ffmpeg",
      "faust",
      "chromium"
    ],
    "variables": {
      "AUDIO_ENCODING_CODEC": "aac",
      "LANG": "en_US.UTF-8",
      "LC_ALL": "en_US.UTF-8"
    }
  }
}
