{
    "name": "toneflix-code/laravel-op",
    "type": "project",
    "description": "A platform to bring creatives in the music industry together to make awesome sounds through collaboration.",
    "keywords": [
        "framework",
        "laravel",
        "toneflix",
        "toneflix-code",
        "library",
        "laravel-op",
        "bootstrap",
        "quick-start"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ably/ably-php": "^1.1",
        "beyondcode/laravel-comments": "^1.9",
        "kreait/firebase-php": "^8.6",
        "laravel-notification-channels/twilio": "^4.2",
        "laravel-notification-channels/webpush": "^13.0",
        "laravel/ai": "^1.3",
        "laravel/framework": "^13.0",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "matomo/device-detector": "^6.5",
        "overtrue/laravel-follow": "^6.0",
        "pbmedia/laravel-ffmpeg": "^8.9",
        "pusher/pusher-php-server": "^7.3",
        "spatie/laravel-permission": "^8.3",
        "staudenmeir/eloquent-json-relations": "^1.15",
        "stripe/stripe-php": "^22.0",
        "toneflix/approvable-notifications": "^2.0",
        "toneflix/kudisms-notification": "^2.0",
        "toneflix/laravel-fileable": "^3.1.1",
        "toneflix/laravel-resource-modifier": "^2.0",
        "toneflix/money": "^1.0",
        "toneflix/paystack-php": "^1.0",
        "toneflix/social-interactions": "^2.0",
        "valorin/random": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-ignition": "^2.12",
        "toneflix-code/fakerphp-lorem-toneflix": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": "@php artisan test",
        "pint": "./vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/money",
            "options": {
                "symlink": true
            }
        }
    ]
}
